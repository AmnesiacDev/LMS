
@Library('leroy-jenkins-library') _

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        ENV_FILE = credentials('lms-env')
        SERVICE_NAME     = 'backend'
        IMAGE_NAME       = 'lms-backend'
        IMAGE_TAG        = "${env.BUILD_NUMBER}"
        INFRA_DIR        = 'LMS_Infra'
        INFRA_REPO_URL   = 'https://github.com/AmnesiacDev/LMS_INFRA.git'
    }

    stages {

        stage('Checkout Backend') {
            steps {
                dir('LMS') {
                    checkout scm
                }
            }
        }

        stage('Checkout Infra') {
            steps {
                dir("${INFRA_DIR}") {
                    git branch: 'main',
                        url: "${INFRA_REPO_URL}"
                }
            }
        }
        stage('Env File') {
            steps {
                dir('LMS') {
                    script {
                        writeFile file: '.env', text: "${ENV_FILE}"
                    }
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    dir('LMS') {
                        dockerBuild("${IMAGE_NAME}", "${IMAGE_TAG}")  
                    }
                }
            }
        }

        stage('Test') {
            agent {label 'node-agent'}
            steps {
                script {
                    imageTestNode("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Deploy') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        composeDeploy("${SERVICE_NAME}")
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Backend pipeline failed at stage: Check backend-debug.log artifact if present."
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
