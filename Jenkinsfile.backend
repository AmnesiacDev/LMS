
@Library('leroy-jenkins-library') _

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)

    }
    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag supplied by orchestrator'
        )
    }

    environment {
        SERVICE_NAME     = 'backend'
        IMAGE_NAME       = 'lms-backend'
        INFRA_DIR        = '/opt/LMS_Infra'
        JOB_BASE_NAME    = env.JOB_BASE_NAME
        WORKDIR          = '/home/jenkins/agent/workspace/algogambit'
    }

    stages {

        stage('Checkout Backend') {
        agent {label 'node-agent'}
            steps {
                dir('LMS') {
                    checkout scm
                }
            }
        }

        stage('Env File') {
            agent {
                label 'node-agent'
            }
        
            steps {
                withCredentials([
                    file(credentialsId: 'lms-env', variable: 'ENV_FILE')
                ]) {
                    dir('LMS') {
                        sh 'cp "$ENV_FILE" .env'
                    }
                }
            }
        }

        stage('Build Image') {
            agent {label 'node-agent'}
            steps {
                script {
                    dir('LMS') {
                        dockerBuild("${IMAGE_NAME}", "${IMAGE_TAG}")  
                    }
                }
            }
        }

        stage('Test') {
            agent {label 'node-agent'}
            steps {
                script {
                    imageTestNode("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Compose Build') {
            agent {label 'node-agent'}
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        composeBuild("${SERVICE_NAME}")
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Backend pipeline failed at stage: Check backend-debug.log artifact if present."
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
