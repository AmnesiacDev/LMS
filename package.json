{
  "name": "lms",
  "version": "1.0.0",
  "type": "module",
  "main": "App.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:sample": "node scripts/seedSampleData.js",
    "seed": "node seed-data.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "restart:prod": "pm2 restart ecosystem.config.js --env production",
    "stop:prod": "pm2 stop ecosystem.config.js",
    "delete:prod": "pm2 delete ecosystem.config.js",
    "logs:prod": "pm2 logs",
    "monit:prod": "pm2 monit"
  },
  "author": "joe",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ics": "^3.12.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.3",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "pdfkit": "^0.18.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "validator": "^13.15.26",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
