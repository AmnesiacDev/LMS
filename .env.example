# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
CONNECTION_STRING=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/lms?retryWrites=true&w=majority

# Optional Mongo pool tuning (defaults: pool=10, select=10000, socket=45000)
MONGO_POOL_SIZE=10
MONGO_SELECT_TIMEOUT=10000
MONGO_SOCKET_TIMEOUT=45000

# ─── CORS / client URL ────────────────────────────────────────────────────────
# CORS_ORIGIN is the canonical name (comma-separated). ALLOWED_ORIGINS is the
# legacy fallback and is still read for backwards compatibility.
CORS_ORIGIN=https://your-frontend-domain.com
CLIENT_URL=https://your-frontend-domain.com

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
SALT_ROUNDS=12
JWT_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
# ms-format string (7d, 2h, 30m). Plain numbers are NOT treated as days.
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (file uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email (password reset, reminders, weekly summaries) ──────────────────────
# Without these, password resets and scheduled emails silently fail.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
[email protected]
EMAIL_PASS=your-smtp-password

# ─── Proxy / hosting ──────────────────────────────────────────────────────────
# Number of proxy hops to trust (Render/Fly/Heroku usually = 1).
TRUST_PROXY=1

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to "true" only on long-lived hosts (VPS / PM2 box). On Render/Fly/Heroku
# leave unset so request logs go to stdout for the host to aggregate.
LOG_TO_DISK=false

# ─── Scheduler ────────────────────────────────────────────────────────────────
# In PM2 cluster mode only worker 0 runs cron. Set to "false" to disable cron
# entirely (e.g. for a dedicated scheduler process or local dev).
SCHEDULER_ENABLED=true

# ─── AI summary (optional) ────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000

# ─── Login lockout (env vars present but not yet wired — coming soon) ─────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900000
REQUEST_TIMEOUT=30000
